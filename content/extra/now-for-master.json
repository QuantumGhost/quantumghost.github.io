{
    "name": "quantumghost.github.io",
    "version": 2,
    "alias": ["blog.quantumghost.me"],
    "builds": [
        {
            "src": "**",
            "use": "@now/static"
        }
    ],
    "regions": [
        "all"
    ],
    "routes": [{ "src": "/(?:[A-Za-z0-9-_]|/)+(?!.\\w+)$", "dest": "$0.html" }]
}
